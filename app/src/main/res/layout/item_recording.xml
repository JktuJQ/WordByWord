<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:paddingHorizontal="12dp" android:paddingTop="0dp" android:paddingBottom="12dp" android:orientation="vertical" android:background="@drawable/card" android:elevation="2dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <CheckBox android:id="@+id/recording_selected" android:layout_width="48dp" android:layout_height="48dp" android:button="@drawable/selection_circle" android:buttonTint="@null" android:background="@drawable/icon_button" android:visibility="gone" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
                <ImageButton android:id="@+id/rename_recording" style="@style/IconButton" android:layout_width="40dp" android:layout_height="48dp" android:background="@android:color/transparent" android:paddingStart="0dp" android:paddingEnd="16dp" android:src="@drawable/ic_edit" android:contentDescription="Изменить название записи" />
                <TextView android:id="@+id/recording_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textColor="@color/ink" android:textSize="17sp" />
            </LinearLayout>
            <TextView android:id="@+id/recording_kind" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="4dp" android:layout_marginBottom="8dp" android:textSize="12sp" />
        </LinearLayout>
        <ImageView android:id="@+id/recording_chevron" android:layout_width="32dp" android:layout_height="32dp" android:padding="4dp" android:src="@drawable/ic_chevron" android:importantForAccessibility="no" />
    </LinearLayout>
    <TextView android:id="@+id/recording_detail" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="4dp" android:layout_marginTop="8dp" android:textSize="13sp" android:visibility="gone" />
    <ProgressBar android:id="@+id/recording_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:max="100" android:progressTint="@color/playback_yellow" android:visibility="gone" />
    <Button android:id="@+id/recording_action" style="@style/SecondaryButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:textSize="14sp" />
</LinearLayout>
