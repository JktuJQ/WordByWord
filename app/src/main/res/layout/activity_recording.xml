<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recording_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@color/background"
    android:orientation="vertical" android:paddingHorizontal="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingTop="18dp">
        <TextView android:id="@+id/recording_back" android:layout_width="48dp"
            android:layout_height="48dp" android:gravity="center" android:text="‹"
            android:textColor="@color/ink" android:textSize="32sp"
            android:contentDescription="@string/back_to_library" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:text="@string/recording_screen_title"
                android:textColor="@color/ink" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/recording_state" style="@style/BodyText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:text="@string/recording_ready"
                android:textSize="12sp" />
        </LinearLayout>
        <Space android:layout_width="48dp" android:layout_height="48dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/recording_active" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center"
        android:orientation="vertical">
        <TextView android:layout_width="210dp" android:layout_height="210dp"
            android:gravity="center" android:background="@drawable/recording_orb"
            android:text="●" android:textColor="@color/surface" android:textSize="92sp" />
        <TextView android:id="@+id/recording_timer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="32dp"
            android:gravity="center" android:text="00:00" android:textColor="@color/ink"
            android:textSize="44sp" android:textStyle="bold" />
        <TextView android:id="@+id/recording_hint" style="@style/BodyText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center"
            android:text="@string/recording_ready" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:layout_marginTop="50dp" android:orientation="horizontal">
            <Button android:id="@+id/recording_pause" style="@style/SecondaryButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/recording_pause" android:visibility="gone" />
            <Button android:id="@+id/recording_start" style="@style/ActionButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/recording_start" />
            <Button android:id="@+id/recording_finish" style="@style/ActionButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/recording_finish" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/recording_cancel" android:layout_width="match_parent"
            android:layout_height="48dp" android:layout_marginTop="14dp"
            android:gravity="center" android:text="@string/recording_cancel"
            android:textColor="@color/error" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/recording_complete" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center"
        android:orientation="vertical" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:text="✓" android:textColor="@color/accent"
            android:textSize="54sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:gravity="center"
            android:text="@string/recording_done" android:textColor="@color/ink"
            android:textSize="21sp" android:textStyle="bold" />
        <Button android:id="@+id/recording_preview" style="@style/SecondaryButton"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="28dp" android:text="@string/recording_preview" />
        <EditText android:id="@+id/recording_name" android:layout_width="match_parent"
            android:layout_height="54dp" android:layout_marginTop="20dp"
            android:background="@drawable/card" android:hint="@string/recording_name_hint"
            android:inputType="textCapSentences" android:paddingHorizontal="16dp"
            android:singleLine="true" />
        <Button android:id="@+id/recording_transcribe" style="@style/ActionButton"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="30dp" android:text="@string/recording_transcribe" />
        <TextView android:id="@+id/recording_delete" android:layout_width="match_parent"
            android:layout_height="48dp" android:gravity="center"
            android:text="@string/delete_selected" android:textColor="@color/error" />
    </LinearLayout>
</LinearLayout>
