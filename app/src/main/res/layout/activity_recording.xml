<?xml version="1.0" encoding="utf-8"?>
<dev.wordbyword.app.HomeGlowLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/recording_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="0dp" android:paddingBottom="0dp">
    <LinearLayout android:id="@+id/recording_toolbar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingTop="18dp" android:paddingHorizontal="24dp">
        <TextView android:id="@+id/recording_back" android:layout_width="48dp"
            android:layout_height="48dp" android:gravity="center" android:text="‹"
            android:textColor="@color/ink" android:textSize="32sp"
            android:contentDescription="@string/back_to_library" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:text="@string/recording_screen_title"
                android:textColor="@color/ink" android:textSize="17sp" android:textStyle="bold" />
        </LinearLayout>
        <Space android:layout_width="48dp" android:layout_height="48dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/recording_active" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center"
        android:orientation="vertical" android:paddingHorizontal="24dp">
        <dev.wordbyword.app.VoiceOrbView android:id="@+id/recording_orb"
            android:layout_width="280dp" android:layout_height="280dp" />
        <TextView android:id="@+id/recording_timer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="32dp"
            android:gravity="center" android:text="00:00" android:textColor="@color/ink"
            android:textSize="52sp" android:fontFamily="@font/soyuz_grotesk" />
        <TextView android:id="@+id/recording_hint" style="@style/BodyText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center"
            android:text="@string/recording_ready" />
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/recording_controls" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="32dp">
            <Button android:id="@+id/recording_start" style="@style/ActionButton" android:layout_width="wrap_content" android:layout_height="56dp" android:layout_gravity="center" android:text="@string/recording_start" />
            <ImageButton android:id="@+id/recording_pause" android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="start|center_vertical" android:padding="16dp" android:background="@drawable/home_glass_secondary" android:src="@drawable/ic_pause" android:contentDescription="@string/recording_pause" android:visibility="gone" />
            <ImageButton android:id="@+id/recording_finish" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginStart="20dp" android:padding="16dp" android:background="@drawable/home_glass_primary" android:src="@drawable/ic_stop" android:contentDescription="@string/recording_finish" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/recording_cancel" android:layout_width="match_parent"
            android:layout_height="48dp" android:layout_marginTop="14dp"
            android:gravity="center" android:text="@string/recording_cancel"
            android:textColor="@color/error" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/recording_complete" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:visibility="gone">
        <dev.wordbyword.app.GlassPanelLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="8dp" android:orientation="vertical" android:gravity="center_horizontal" android:paddingHorizontal="40dp" android:paddingTop="42dp" android:paddingBottom="30dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/recording_done" android:textColor="@color/ink" android:textSize="24sp" android:fontFamily="@font/soyuz_grotesk" />
            <EditText android:id="@+id/recording_name" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/recording_name_field" android:hint="@string/recording_name_hint" android:inputType="textCapSentences" android:paddingHorizontal="20dp" android:singleLine="true" android:textSize="16sp" />
            <include layout="@layout/view_recording_preview" />
            <Button android:id="@+id/recording_transcribe" style="@style/ActionButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="@string/recording_transcribe" />
            <TextView android:id="@+id/recording_delete" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="0dp" android:gravity="center" android:text="@string/delete_selected" android:textColor="@color/ink" android:background="?android:attr/selectableItemBackgroundBorderless" />
        </dev.wordbyword.app.GlassPanelLayout>
    </LinearLayout>
</LinearLayout>
</ScrollView>
</dev.wordbyword.app.HomeGlowLayout>
