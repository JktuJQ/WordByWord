<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="14dp" android:paddingBottom="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/back" android:layout_width="48dp" android:layout_height="48dp"
                android:gravity="center" android:text="‹" android:textSize="32sp"
                android:contentDescription="@string/back_to_library" android:textColor="@color/ink" android:visibility="gone" />
            <TextView android:id="@+id/screen_title" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:ellipsize="end" android:maxLines="2"
                android:text="@string/library" android:textColor="@color/ink" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:id="@+id/search_toggle" android:layout_width="48dp" android:layout_height="48dp"
                android:gravity="center" android:text="⌕" android:textSize="29sp" android:textColor="@color/ink"
                android:contentDescription="@string/search" />
            <TextView android:id="@+id/select_toggle" android:layout_width="wrap_content" android:layout_height="48dp"
                android:gravity="center" android:paddingStart="8dp" android:text="@string/select_records"
                android:textColor="@color/accent" android:textSize="14sp" />
            <TextView android:id="@+id/export_json" android:layout_width="48dp" android:layout_height="48dp"
                android:gravity="center" android:text="↥" android:textSize="25sp" android:textColor="@color/ink"
                android:contentDescription="@string/export_json" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/screen_description" style="@style/BodyText"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/library_description"
            android:textSize="12sp" />
        <EditText android:id="@+id/search_input" android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="12dp" android:background="@drawable/card"
            android:hint="@string/search_hint" android:inputType="text" android:singleLine="true"
            android:paddingHorizontal="16dp" android:textSize="15sp" android:visibility="gone" />
    </LinearLayout>

    <TextView android:id="@+id/message" style="@style/BodyText"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp" android:padding="12dp" android:background="@drawable/notice"
        android:accessibilityLiveRegion="polite" android:visibility="gone" />

    <ScrollView android:id="@+id/content_scroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingBottom="20dp">
            <LinearLayout android:id="@+id/empty" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="52dp"
                android:gravity="center_horizontal" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="72dp" android:layout_height="72dp"
                    android:gravity="center" android:background="@drawable/notice"
                    android:text="♫" android:textColor="@color/accent" android:textSize="34sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="24dp" android:gravity="center" android:text="@string/empty_title"
                    android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" />
                <TextView style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:gravity="center" android:text="@string/empty_description" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="28dp" android:background="@drawable/card"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView style="@style/BodyText" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/benefit_speakers"
                        android:textColor="@color/ink" android:textSize="13sp" />
                    <TextView style="@style/BodyText" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:text="@string/benefit_timestamps" android:textColor="@color/ink"
                        android:textSize="13sp" />
                    <TextView style="@style/BodyText" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:text="@string/benefit_privacy" android:textColor="@color/ink"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/no_search_results" style="@style/BodyText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="80dp" android:gravity="center"
                android:text="@string/no_search_results" android:visibility="gone" />
            <LinearLayout android:id="@+id/items" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <include android:id="@+id/transcript_playback" layout="@layout/view_playback_status"
        android:visibility="gone" />

    <LinearLayout android:id="@+id/selection_actions" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingHorizontal="20dp" android:paddingVertical="8dp"
        android:background="@color/surface" android:visibility="gone">
        <Button android:id="@+id/share_selected" style="@style/SecondaryButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/share_selected" />
        <TextView android:id="@+id/selected_count" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:paddingHorizontal="12dp"
            android:textColor="@color/muted" android:textSize="13sp" />
        <Button android:id="@+id/delete_selected" style="@style/SecondaryButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/delete_selected" />
    </LinearLayout>
    <LinearLayout android:id="@+id/library_actions" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingHorizontal="20dp" android:paddingTop="8dp" android:paddingBottom="12dp">
        <Button android:id="@+id/import_audio" style="@style/ActionButton"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/rounded_import_button" android:text="@string/import_audio" />
        <TextView android:id="@+id/record_shortcut" android:layout_width="match_parent"
            android:layout_height="40dp" android:gravity="center"
            android:text="@string/recording_shortcut" android:textColor="@color/accent"
            android:textSize="14sp" />
        <TextView style="@style/BodyText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center"
            android:text="@string/privacy_notice" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
