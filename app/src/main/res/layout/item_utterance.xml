<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="16dp" android:orientation="vertical" android:padding="20dp" android:background="@drawable/card">
    <TextView android:id="@+id/speaker" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/accent" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/timing" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="@color/muted" android:textSize="12sp" />
    <TextView android:id="@+id/utterance_text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:textColor="@color/ink" android:textSize="18sp" android:lineSpacingExtra="4dp" android:textIsSelectable="true" />
</LinearLayout>
