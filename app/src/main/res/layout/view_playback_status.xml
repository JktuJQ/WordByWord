<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@color/surface" android:orientation="vertical"
    android:paddingHorizontal="20dp" android:paddingTop="8dp" android:paddingBottom="12dp">
    <TextView android:id="@+id/playback_position" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center"
        android:text="@string/playback_initial_position" android:textColor="@color/ink"
        android:textSize="13sp" />
    <SeekBar android:id="@+id/playback_seekbar" android:layout_width="match_parent"
        android:layout_height="48dp" android:layout_marginTop="4dp"
        android:contentDescription="@string/playback_position_description"
        android:progressTint="@color/accent" android:thumbTint="@color/accent" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/playback_back" android:layout_width="64dp"
            android:layout_height="48dp" android:gravity="center" android:text="↶"
            android:textColor="@color/accent" android:textSize="27sp"
            android:contentDescription="@string/seek_back" />
        <TextView android:id="@+id/playback_toggle" android:layout_width="72dp"
            android:layout_height="48dp" android:gravity="center" android:text="▶"
            android:background="@drawable/rounded_import_button" android:textColor="@color/surface" android:textSize="26sp"
            android:contentDescription="@string/play_utterance" />
        <TextView android:id="@+id/playback_forward" android:layout_width="64dp"
            android:layout_height="48dp" android:gravity="center" android:text="↷"
            android:textColor="@color/accent" android:textSize="27sp"
            android:contentDescription="@string/seek_forward" />
    </LinearLayout>
</LinearLayout>
