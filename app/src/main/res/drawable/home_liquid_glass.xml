<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#28FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="24dp" />
                    <gradient android:angle="270" android:startColor="#88FFFFFF" android:centerColor="#3CFFFFFF" android:endColor="#5CFFFFFF" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape>
                    <corners android:radius="23dp" />
                    <gradient android:angle="270" android:startColor="#32FFFFFF" android:centerColor="#22FFFFFF" android:endColor="#2AFFFFFF" />
                    <stroke android:width="1dp" android:color="#55FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
